# ==============================================================================
# 1. ENTORNO VIRTUAL, SECRETOS Y CACHÉ DE PYTHON / JUPYTER
# ==============================================================================
.env
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
cache/

# ==============================================================================
# 2. DATOS Y ARCHIVOS PARQUET (EXCEPTO HISTÓRICO Y SNAPSHOTS CONGELADOS)
# ==============================================================================
# Ignoramos todos los ficheros de datos pesados y capas vivas
*.parquet
*.csv
data/silver/
data/gold/
data/predictions/

# Protegemos el histórico diario versionado por GitHub Actions
data/raw/*
!data/raw/historical/
!data/raw/historical/*.parquet

# Permitimos subir las carpetas vacías de los snapshots de ML y su .gitkeep
!data/gold_snapshot_ml_20261122/
!data/gold_snapshot_ml_20261122/.gitkeep

# ==============================================================================
# 3. ARTEFACTOS DE MODELOS (SE VERSIONA metadata.json, NO LOS BINARIOS)
# ==============================================================================
*.joblib
*.pkl

# ==============================================================================
# 4. DOCUMENTACIÓN COMPILADA Y ARCHIVOS AUXILIARES DEL PROYECTO
# ==============================================================================
*.pdf
material/
data_EDA/
notebooks/BBDD/

# ==============================================================================
# 5. ARCHIVOS DEL SISTEMA OPERATIVO / GOOGLE DRIVE DESKTOP
# ==============================================================================
desktop.ini
Thumbs.db
.DS_Store